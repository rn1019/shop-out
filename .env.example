# Hosts
VITE_API_BASE_URL=http://localhost/sss/
VITE_API_LIVE_URL=https://gateway.streetstylestore.com

# Kis endpoint ko kis host par chalana hai: base | live
# (cart se jude calls -- BUYNOW, RESETCOOKIE, SETORDER -- ek hi host par rakhna)
VITE_HOST_USERLOGIN=base
VITE_HOST_PRODUCTS=live
VITE_HOST_BUYNOW=live
VITE_HOST_SEARCHCUSTOMER=live
VITE_HOST_CUSTOMERDETAILS=live
VITE_HOST_RESETCOOKIE=live
VITE_HOST_SETORDER=live

# Cross-site cookies chahiye to true (server me CORS credentials allow hona chahiye)
VITE_WITH_CREDENTIALS=false
